# Base URL of the CV Adapter API (see docs/backend-api.md). Optional:
# without it the app uses https://api.lovoxmabuilds.md.
EXPO_PUBLIC_API_URL=https://api.lovoxmabuilds.md

# Adapty public SDK key (Adapty dashboard → App settings → API keys).
# Not needed in Expo Go, where the SDK runs in mock mode by itself.
EXPO_PUBLIC_ADAPTY_KEY=
# Placement whose paywall holds the yearly and monthly products.
EXPO_PUBLIC_ADAPTY_PLACEMENT=main
